      "why_stress_harder_than_elsewhere": "spreads before 2016 were wider than the convention was calibrated on, and this span reaches back to 1999, so the result is reported at 2x and 3x as well as at 1x"
    },
    "data": {
      "cpi": "BIS long consumer price series, monthly index, one provider for all eight countries",
      "fx": "ECB euro foreign-exchange reference rates, daily, one 14:15 CET snapshot for every currency, so the cross-section is synchronous",
      "protected_span_excluded_at_the_request": true,
      "span": {
        "first": "1999-01-04",
        "last": "2016-06-01"
      },
      "status_of_the_span_once_read": "EXPLORATORY_SEEN_DEVELOPMENT_DATA, never available for confirmation"
    },
    "evaluated_separately_not_merged": "standalone economics, stability, turnover and cost, and any future diversification value are reported apart. A net Sharpe below the bands is not rescued by calling it a diversifier, and no fixed 0.5 rule is applied to close the family",
    "metrics": [
